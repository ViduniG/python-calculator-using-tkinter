import tkinter
from tkinter import ttk
import math
button_values = [
    ["AC", "+/-", "%", "÷"], 
    ["7", "8", "9", "×"], 
    ["4", "5", "6", "-"],
    ["1", "2", "3", "+"],
    ["0", ".", "√", "="]
]

right_symbols = ["÷", "×", "-", "+", "="]
top_symbols = ["AC", "+/-", "%"]

row_count = len(button_values)
column_count = len(button_values[0])

color_pale_plum = "#E0BBE4"
color_pastel_purple = "#957DAD"
color_buckingham_lilac = "#D291BC"
color_bubblegum_pink = "#FEC8D8"
color_simple_rose_gold = "#FFDFD3"
color_white = "white"

A = "0" #number on screen 
operator = None 
B ="" #the second number when operator is picked
def button_clicked(value):
    global A, operator, B
    
    if value.isdigit():
        if operator is None:
            if A == "0":
                A = value
            else:
                A = A + value
            label.config(text=A)
        else:
            if B == "":
                B = value
            else:
                B = B + value
            label.config(text=B)
    
    elif value == "AC":
        A = "0"
        operator = None
        B = ""
        label.config(text=A)

    
    elif value in ["+", "-", "×", "÷"]:
        operator = value
        B = ""

    elif value == ".":
        if operator is None:
            if "." not in A:
                A = A + "."
                label.config(text=A)
        else:
            if "." not in B:
                B = B + "."
                label.config(text=B)

    elif value == "+/-":
        if operator is None:
            if A.startswith("-"):
                A = A[1:]
            else:
                A = "-" + A
            label.config(text=A)
        else:
            if B.startswith("-"):
                B = B[1:]
            else:
                B = "-" + B
            label.config(text=B)

    elif value == "%":
        if operator is None:
            A = str(float(A) /100)
            label.config(text=A)

        else:
            B = str(float(B) /100)
            label.config(text=B)

    elif value == "√":
        if operator is None:
            A = str(math.sqrt(float(A)))
            label.config(text=A)

        else:
            B = str(math.sqrt(float(B)))
            label.config(text=B)

    elif value == "=":
        num1 = float(A)
        num2 = float(B)

        if operator == "+":
            result = num1 + num2
        elif operator == "-":
            result = num1 - num2
        elif operator == "×":
            result = num1 * num2
        elif operator == "÷":
            result = num1 / num2

        
        A = str(result)
        operator = None
        B = ""
        label.config(text=A)

window = tkinter.Tk() #create the window
window.title("calculator1")
window.resizable(False, False)

style = ttk.Style()
style.theme_use('clam')

style.configure("BuckinghamLilac.TButton", foreground=color_white, background=color_buckingham_lilac, font=("Arial", 30), padding=10, width=3)
style.configure("PastelPurple.TButton", foreground=color_white, background=color_pastel_purple, font=("Arial", 30), padding=10, width=3)
style.configure("PalePlum.TButton", foreground=color_white, background=color_pale_plum, font=("Arial", 30), padding=10, width=3)

frame = tkinter.Frame(window) #placing the frame inside the window
label = tkinter.Label(frame, text="0", font=("Arial", 45), background=color_bubblegum_pink,
                      foreground=color_white, anchor="e")

label.grid(row=0, column=0, columnspan=column_count, sticky="we")


for row in range(row_count):
    for column in range(column_count):
        value = button_values[row][column]
        button = ttk.Button(frame, text=value,
                     command=lambda value=value: button_clicked(value))

        if value in top_symbols:
            button.configure(style="BuckinghamLilac.TButton")
        elif value in right_symbols:
            button.configure(style="PastelPurple.TButton")
        else:
            button.configure(style="PalePlum.TButton")

        button.grid(row=row+1, column=column)

frame.pack()



window.mainloop() #window stays open while the program is running
